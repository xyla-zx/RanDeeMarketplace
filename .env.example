# Database
DATABASE_URL="postgresql://randee:randee@localhost:5432/randee?schema=public"
DIRECT_DATABASE_URL="postgresql://randee:randee@localhost:5432/randee?schema=public"

# Redis (for sessions, cache, queues)
REDIS_URL="redis://localhost:6379"

# S3-compatible storage (for images)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="randee"
S3_REGION="us-east-1"

# Omise payment gateway
OMISE_PKEY="pkey_test_..."
OMISE_SKEY="skey_test_..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth
JWT_SECRET="change-me-in-production"
OTP_EXPIRY_SECONDS="300"

# Search (Meilisearch)
MEILI_URL="http://localhost:7700"
MEILI_MASTER_KEY="masterKey"

# Push notifications (VAPID)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Analytics (optional)
POSTHOG_API_KEY=""
