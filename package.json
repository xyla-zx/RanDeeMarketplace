{
  "name": "randee",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:migrate": "pnpm --filter @randee/db prisma migrate dev",
    "db:push": "pnpm --filter @randee/db prisma db push",
    "db:studio": "pnpm --filter @randee/db prisma studio",
    "db:seed": "pnpm --filter @randee/db tsx src/seed/index.ts",
    "db:reset": "pnpm --filter @randee/db prisma migrate reset --force",
    "search:reindex": "tsx scripts/reindex.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "docker:up": "docker compose -f docker/compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/compose.dev.yml down",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "check:contrast": "tsx scripts/check-contrast.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "bcryptjs": "^3.0.3",
    "next-auth": "5.0.0-beta.32"
  }
}
